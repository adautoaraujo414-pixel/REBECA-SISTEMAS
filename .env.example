# ============================================
# UBMAX - VARIÁVEIS DE AMBIENTE
# Configure no Railway ou no seu servidor
# ============================================

# SERVIDOR
PORT=3000
NODE_ENV=production
BASE_URL=https://seu-projeto.up.railway.app

# BANCO DE DADOS
# Railway configura automaticamente o DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ============================================
# OPENAI (OBRIGATÓRIO)
# ============================================
# Pegue sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-openai-aqui

# ============================================
# JWT SECRET (OBRIGATÓRIO)
# ============================================
# Crie uma senha longa e aleatória
JWT_SECRET=sua-senha-super-secreta-muito-longa-123

# ============================================
# WHATSAPP - EVOLUTION API (QR CODE)
# ============================================
# URL da sua Evolution API (pode ser no mesmo Railway)
EVOLUTION_API_URL=https://sua-evolution.railway.app

# API Key da Evolution (você define ao instalar)
EVOLUTION_API_KEY=sua-api-key-evolution

# Nome padrão da instância (sistema cria automaticamente por empresa)
EVOLUTION_INSTANCE=rebeca

# ============================================
# WHATSAPP - API OFICIAL (OPCIONAL - PARA DEPOIS)
# ============================================
# Token de verificação do webhook
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=ubmax_webhook_token_2024

# ============================================
# OPCIONAIS
# ============================================
# Cidade padrão (fallback se não tiver no cadastro)
# CIDADE_FROTA=São Paulo

# Horário de funcionamento da Rebeca
# HORARIO_INICIO=06:00
# HORARIO_FIM=23:00

# Delays humanizados (milissegundos)
# REBECA_DELAY_CONFIRMACAO_MIN=1000
# REBECA_DELAY_CONFIRMACAO_MAX=3000
